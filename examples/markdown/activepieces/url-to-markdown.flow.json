{
  "name": "ReplyNodes - URL to Markdown (keyless)",
  "type": "SHARED",
  "summary": "URL in, clean Markdown out. Keyless, built-in steps only.",
  "description": "Turn any public page URL into clean Markdown. Send a URL to the webhook, fetch it with the built-in HTTP step from the free ReplyNodes endpoint, then get markdown and source_url back. No API key or account needed.",
  "tags": [],
  "blogUrl": "https://github.com/replynodes/free-markdown-brand-logo-api/blob/main/examples/markdown/activepieces/README.md",
  "metadata": {},
  "author": "",
  "categories": [],
  "pieces": [
    "@activepieces/piece-webhook",
    "@activepieces/piece-data-mapper",
    "@activepieces/piece-http"
  ],
  "flows": [
    {
      "displayName": "ReplyNodes - URL to Markdown (keyless)",
      "trigger": {
        "name": "trigger",
        "valid": true,
        "displayName": "Webhook: receive url",
        "nextAction": {
          "name": "step_1",
          "type": "PIECE",
          "valid": true,
          "settings": {
            "input": {
              "mapping": {
                "url": "{{trigger['body']['url']}}"
              }
            },
            "pieceName": "@activepieces/piece-data-mapper",
            "actionName": "advanced_mapping",
            "sampleData": {},
            "pieceVersion": "0.3.21",
            "propertySettings": {
              "mapping": {
                "type": "MANUAL"
              }
            }
          },
          "nextAction": {
            "name": "step_2",
            "type": "PIECE",
            "valid": true,
            "settings": {
              "input": {
                "url": "https://md.replynodes.com/{{step_1['url']}}",
                "method": "GET",
                "headers": {
                  "Accept": "application/json"
                },
                "timeout": 60,
                "authType": "NONE",
                "body_type": "none",
                "use_proxy": false,
                "failureMode": "continue_4xx",
                "queryParams": {},
                "followRedirects": false,
                "response_is_binary": false
              },
              "pieceName": "@activepieces/piece-http",
              "actionName": "send_request",
              "sampleData": {},
              "pieceVersion": "0.11.19",
              "propertySettings": {
                "url": {
                  "type": "MANUAL"
                },
                "method": {
                  "type": "MANUAL"
                },
                "headers": {
                  "type": "MANUAL"
                },
                "timeout": {
                  "type": "MANUAL"
                },
                "authType": {
                  "type": "MANUAL"
                },
                "body_type": {
                  "type": "MANUAL"
                },
                "use_proxy": {
                  "type": "MANUAL"
                },
                "failureMode": {
                  "type": "MANUAL"
                },
                "queryParams": {
                  "type": "MANUAL"
                },
                "followRedirects": {
                  "type": "MANUAL"
                },
                "response_is_binary": {
                  "type": "MANUAL"
                }
              }
            },
            "nextAction": {
              "name": "step_3",
              "type": "ROUTER",
              "valid": true,
              "children": [
                {
                  "name": "step_4",
                  "type": "PIECE",
                  "valid": true,
                  "settings": {
                    "input": {
                      "mapping": {
                        "markdown": "{{step_2['body']['data']['markdown']}}",
                        "source_url": "{{step_2['body']['data']['url']}}"
                      }
                    },
                    "pieceName": "@activepieces/piece-data-mapper",
                    "actionName": "advanced_mapping",
                    "sampleData": {},
                    "pieceVersion": "0.3.21",
                    "propertySettings": {
                      "mapping": {
                        "type": "MANUAL"
                      }
                    }
                  },
                  "displayName": "Output: markdown + source_url",
                  "lastUpdatedDate": "2026-10-29T05:08:38.116Z"
                },
                {
                  "name": "step_5",
                  "type": "PIECE",
                  "valid": true,
                  "settings": {
                    "input": {
                      "fields": {
                        "body": {
                          "error": "invalid_request",
                          "message": "Send a full public https:// page URL, for example https://example.com/docs?x=1."
                        },
                        "status": 400,
                        "headers": {}
                      },
                      "respond": "stop",
                      "responseType": "json"
                    },
                    "pieceName": "@activepieces/piece-webhook",
                    "actionName": "return_response",
                    "sampleData": {},
                    "pieceVersion": "0.1.43",
                    "propertySettings": {
                      "fields": {
                        "type": "DYNAMIC"
                      },
                      "respond": {
                        "type": "MANUAL"
                      },
                      "responseType": {
                        "type": "MANUAL"
                      }
                    }
                  },
                  "displayName": "Stop: 400 invalid_request",
                  "lastUpdatedDate": "2026-10-29T05:08:38.117Z"
                },
                {
                  "name": "step_6",
                  "type": "PIECE",
                  "valid": true,
                  "settings": {
                    "input": {
                      "fields": {
                        "body": {
                          "error": "anonymous_limit_reached",
                          "message": "Free keyless limit reached (100 requests per day per IP bucket, UTC day). Not retried. The quota resets at the next UTC midnight. A free account with 500 credits: https://platform.replynodes.com/sign-up"
                        },
                        "status": 429,
                        "headers": {}
                      },
                      "respond": "stop",
                      "responseType": "json"
                    },
                    "pieceName": "@activepieces/piece-webhook",
                    "actionName": "return_response",
                    "sampleData": {},
                    "pieceVersion": "0.1.43",
                    "propertySettings": {
                      "fields": {
                        "type": "DYNAMIC"
                      },
                      "respond": {
                        "type": "MANUAL"
                      },
                      "responseType": {
                        "type": "MANUAL"
                      }
                    }
                  },
                  "displayName": "Stop: 429 anonymous_limit_reached",
                  "lastUpdatedDate": "2026-10-29T05:08:38.118Z"
                },
                {
                  "name": "step_7",
                  "type": "PIECE",
                  "valid": true,
                  "settings": {
                    "input": {
                      "fields": {
                        "body": {
                          "error": "unavailable_for_legal_reasons",
                          "message": "The publisher has excluded this page. Use a different page."
                        },
                        "status": 451,
                        "headers": {}
                      },
                      "respond": "stop",
                      "responseType": "json"
                    },
                    "pieceName": "@activepieces/piece-webhook",
                    "actionName": "return_response",
                    "sampleData": {},
                    "pieceVersion": "0.1.43",
                    "propertySettings": {
                      "fields": {
                        "type": "DYNAMIC"
                      },
                      "respond": {
                        "type": "MANUAL"
                      },
                      "responseType": {
                        "type": "MANUAL"
                      }
                    }
                  },
                  "displayName": "Stop: 451 excluded by publisher",
                  "lastUpdatedDate": "2026-10-29T05:08:38.118Z"
                },
                {
                  "name": "step_8",
                  "type": "PIECE",
                  "valid": true,
                  "settings": {
                    "input": {
                      "fields": {
                        "body": {
                          "error": "request_failed",
                          "message": "ReplyNodes did not return Markdown for this URL. Open this run's HTTP step to see the status and body."
                        },
                        "status": 502,
                        "headers": {}
                      },
                      "respond": "stop",
                      "responseType": "json"
                    },
                    "pieceName": "@activepieces/piece-webhook",
                    "actionName": "return_response",
                    "sampleData": {},
                    "pieceVersion": "0.1.43",
                    "propertySettings": {
                      "fields": {
                        "type": "DYNAMIC"
                      },
                      "respond": {
                        "type": "MANUAL"
                      },
                      "responseType": {
                        "type": "MANUAL"
                      }
                    }
                  },
                  "displayName": "Stop: other error",
                  "lastUpdatedDate": "2026-10-29T05:08:38.118Z"
                }
              ],
              "settings": {
                "branches": [
                  {
                    "branchName": "OK (2xx): output Markdown",
                    "branchType": "CONDITION",
                    "conditions": [
                      [
                        {
                          "operator": "NUMBER_IS_GREATER_THAN",
                          "firstValue": "{{step_2?.status}}",
                          "secondValue": "199"
                        },
                        {
                          "operator": "NUMBER_IS_LESS_THAN",
                          "firstValue": "{{step_2?.status}}",
                          "secondValue": "300"
                        }
                      ]
                    ]
                  },
                  {
                    "branchName": "400: invalid URL (stop)",
                    "branchType": "CONDITION",
                    "conditions": [
                      [
                        {
                          "operator": "NUMBER_IS_EQUAL_TO",
                          "firstValue": "{{step_2?.response?.status}}",
                          "secondValue": "400"
                        }
                      ]
                    ]
                  },
                  {
                    "branchName": "429: daily keyless limit (stop, no retry)",
                    "branchType": "CONDITION",
                    "conditions": [
                      [
                        {
                          "operator": "NUMBER_IS_EQUAL_TO",
                          "firstValue": "{{step_2?.response?.status}}",
                          "secondValue": "429"
                        }
                      ]
                    ]
                  },
                  {
                    "branchName": "451: page excluded by publisher (stop)",
                    "branchType": "CONDITION",
                    "conditions": [
                      [
                        {
                          "operator": "NUMBER_IS_EQUAL_TO",
                          "firstValue": "{{step_2?.response?.status}}",
                          "secondValue": "451"
                        }
                      ]
                    ]
                  },
                  {
                    "branchName": "Other error (stop)",
                    "branchType": "FALLBACK"
                  }
                ],
                "sampleData": {},
                "executionType": "EXECUTE_FIRST_MATCH"
              },
              "displayName": "Route response",
              "lastUpdatedDate": "2026-10-29T05:08:38.114Z"

    {
      "parameters": {
        "errorMessage": "={{ (() => {\n  const s = $json.statusCode;\n  const e = ($json.body && $json.body.error) || {};\n  const h = $json.headers || {};\n  const tag = 'ReplyNodes Markdown HTTP ' + s + ' ' + (e.code || 'unknown_error') + (e.reason ? ' (' + e.reason + ')' : '') + ': ';\n  if (s === 400) return tag + 'the url is not a valid public http(s) page URL. Fix the url in the Input URL node. Not retried.';\n  if (s === 429) {\n    const r = Number(h['x-ratelimit-reset']);\n    const when = r ? new Date(r * 1000).toISOString() : 'unknown (no x-ratelimit-reset header)';\n    return tag + 'keyless daily limit (100/day, shared by everyone behind the same egress IP) reached. Stopped, not retrying. Quota resets at ' + when + ' (UTC). Or create a free account (500 credits): https://platform.replynodes.com/sign-up';\n  }\n  if (s === 451) return tag + 'the publisher has excluded this page, so it cannot be returned. Not retried. Try a different page.';\n  if (s === 502 && e.code === 'upstream_blocked') return tag + 'the target site blocked the fetch. Not retried. Try a different page.';\n  if (s === 502 && e.reason === 'empty_content') return tag + 'the page returned no extractable content (for example a JavaScript-only page). Not retried.';\n  if (s >= 500 && e.retryable === true) return tag + 'still failing after 3 attempts (2 bounded retries). Try again later.';\n  if (s >= 500) return tag + 'upstream error that is not marked retryable. Not retried.';\n  return tag + 'unexpected response. Not retried.';\n})() }}"
      },
